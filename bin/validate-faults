#!/usr/bin/env python3
import json
import os
from pathlib import Path
import subprocess
import time
import sys

root = Path(__file__).resolve().parent.parent
results = root / ".localfiles/results"
results.mkdir(parents=True, exist_ok=True)
request = results / "fault-request.json"
if request.exists():
    request.unlink()
command = ["docker", "run", "--rm", "--network", "host", "-e", "REPORT_NAME=faults", "-e", f'DEMO_URL={os.environ.get("DEMO_URL", "https://cloud-ws.localhost:3443")}', "-v", f"{root}/test:/tests/test:ro", "-v", f"{root}/playwright.config.mjs:/tests/playwright.config.mjs:ro", "-v", f"{results}:/results", "rails-cloud-websockets-tests:local", "npx", "playwright", "test", "test/browser/faults.spec.mjs", "--max-failures=1", *sys.argv[1:]]
process = subprocess.Popen(command, cwd=root)
handled = set()
try:
    while process.poll() is None:
        if request.exists():
            data = json.loads(request.read_text())
            if data["id"] not in handled:
                if data["service"] == "reverb":
                    subprocess.run(["docker", "compose", "restart", "reverb"], cwd=root, check=True)
                elif data["service"] == "workers":
                    for replica in ["rails1", "rails2"]:
                        subprocess.run(["docker", "compose", "exec", "-T", replica, "ruby", "-e", 'Dir["/proc/[0-9]*/cmdline"].each { |file| pid = file.split("/")[2].to_i; text = File.binread(file) rescue next; Process.kill("KILL", pid) if pid != Process.pid && text.include?("puma: cluster worker") }'], cwd=root, check=True)
                else:
                    raise RuntimeError("Unexpected fault service")
                handled.add(data["id"])
                (results / f'{data["id"]}.done').touch()
        time.sleep(0.2)
finally:
    if process.poll() is None:
        process.terminate()
raise SystemExit(process.wait())
