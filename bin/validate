#!/usr/bin/env python3
from pathlib import Path
import os
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
results = root / ".localfiles/results"
results.mkdir(parents=True, exist_ok=True)
def run(args):
    subprocess.run(args, cwd=root, check=True)

mode = sys.argv[1] if len(sys.argv) > 1 else "all"
url = os.environ.get("DEMO_URL", "https://cloud-ws.localhost:3443")
if mode in ["all", "protocol"]:
    run(["docker", "run", "--rm", "--network", "host", "-e", f"DEMO_URL={url}", "-e", "NODE_EXTRA_CA_CERTS=/certs/ca.pem", "-v", "rails-cloud-websockets_certs:/certs:ro", "-v", f"{root}/test:/test:ro", "node:24-bookworm-slim", "node", "--test", "--test-force-exit", "/test/protocol/contracts.test.mjs"])
if mode in ["all", "browser", "readiness", "engines"]:
    run(["docker", "build", "-f", "docker/tests/Dockerfile", "-t", "rails-cloud-websockets-tests:local", "."])
    file = "test/browser/clients.spec.mjs" if mode != "readiness" else "test/readiness/anycable.spec.mjs"
    args = ["docker", "run", "--rm", "--network", "host", "-e", f"DEMO_URL={url}", "-e", f"REPORT_NAME={mode}", "-v", f"{root}/test:/tests/test:ro", "-v", f"{root}/playwright.config.mjs:/tests/playwright.config.mjs:ro", "-v", f"{results}:/results", "rails-cloud-websockets-tests:local", "npx", "playwright", "test"]
    if mode in ["readiness", "engines"]:
        config = f"playwright.{mode}.config.mjs"
        args += [f"--config={config}"]
        args[args.index("rails-cloud-websockets-tests:local"):args.index("rails-cloud-websockets-tests:local")] = ["-v", f"{root}/{config}:/tests/{config}:ro"]
    run(args + [file])
if mode == "all":
    run([str(root / "bin/validate"), "engines"])
    run([str(root / "bin/validate-faults")])
    run([str(root / "bin/load")])
if mode not in ["all", "protocol", "browser", "readiness", "engines"]:
    raise SystemExit("Use all, protocol, browser, engines, or readiness")
