#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
revision=$(awk '/revision:/ { print $2; exit }' Gemfile.lock)
docker build -f docker/gem-tests/Dockerfile --build-arg "GEM_REVISION=$revision" --build-arg "RUBY_VERSION=${RUBY_VERSION:-3.4.10}" --build-arg "RAILS_VERSION=${RAILS_VERSION:-8.1.3.1}" -t rails-cloud-websockets-gem-check:local .
docker run --rm --network none rails-cloud-websockets-gem-check:local
